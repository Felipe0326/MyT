# Plantilla sin credenciales reales.
# En producción, las variables privadas se configuran en el entorno del servidor.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://localhost:3000

# Opcional. Recomendado: secreto aleatorio de al menos 32 caracteres.
RATE_LIMIT_SECRET=

# SMTP institucional.
SMTP_HOST=
SMTP_PORT=587
SMTP_FALLBACK_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_AUTH_METHOD=LOGIN
SMTP_BOUNCE_TO=
EMAIL_FROM=
EMAIL_REPLY_TO=

# Respaldo opcional para correo.
RESEND_API_KEY=

# n8n: variables exclusivas del servidor. Nunca usar NEXT_PUBLIC_.
N8N_LICENCIAS_WEBHOOK_URL=
N8N_REFRENDOS_WEBHOOK_URL=
N8N_NPS_WEBHOOK_URL=
N8N_WEBHOOK_ALLOWED_HOSTS=
N8N_WEBHOOK_AUTH_REQUIRED=true
N8N_LICENCIAS_WEBHOOK_SECRET=
N8N_REFRENDOS_WEBHOOK_SECRET=
N8N_NPS_WEBHOOK_SECRET=
N8N_WEBHOOK_SECRET=
