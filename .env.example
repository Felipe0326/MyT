# Plantilla de variables de entorno.
SUPABASE_URL=https://TU-DOMINIO-SUPABASE
SUPABASE_ANON_KEY=COLOCA_AQUI_LA_CLAVE_ANON
SUPABASE_SERVICE_ROLE_KEY=COLOCA_AQUI_LA_CLAVE_SERVICE_ROLE

# En producción debe ser la URL HTTPS pública exacta.
APP_URL=http://localhost:3000

# Opcional: secreto de al menos 32 caracteres para anonimizar IP/cuenta
# en los límites de intentos. Si se deja vacío, se usa internamente la
# SUPABASE_SERVICE_ROLE_KEY; nunca se envía al navegador.
RATE_LIMIT_SECRET=

# SMTP institucional. Completar cuando TI entregue los datos.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
# Por seguridad es true de forma predeterminada en conexiones no TLS directo.
SMTP_REQUIRE_TLS=
SMTP_USER=tlamati@morelos.gob.mx
SMTP_PASS=

EMAIL_FROM=Movilidad y Transporte <tlamati@morelos.gob.mx>
EMAIL_REPLY_TO=tlamati@morelos.gob.mx

# Respaldo opcional. SMTP tiene prioridad cuando está configurado.
RESEND_API_KEY=

# Webhooks de n8n. Son variables EXCLUSIVAS del servidor: nunca uses NEXT_PUBLIC_.
# Las URL reales se configuran como variables privadas en Vercel.
N8N_LICENCIAS_WEBHOOK_URL=
N8N_REFRENDOS_WEBHOOK_URL=
N8N_NPS_WEBHOOK_URL=

# Lista opcional de hosts autorizados, separados por coma.
N8N_WEBHOOK_ALLOWED_HOSTS=

# Durante el despliegue gradual puede iniciar en false. Después de activar
# Header Auth en los tres nodos Webhook de n8n debe quedar en true.
N8N_WEBHOOK_AUTH_REQUIRED=false

# Recomendado: un secreto distinto para cada flujo. N8N_WEBHOOK_SECRET sirve
# únicamente como respaldo común y debe dejarse vacío si se usan los tres.
N8N_LICENCIAS_WEBHOOK_SECRET=
N8N_REFRENDOS_WEBHOOK_SECRET=
N8N_NPS_WEBHOOK_SECRET=
N8N_WEBHOOK_SECRET=
